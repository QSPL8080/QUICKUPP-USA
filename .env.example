# Copy this file to .env.local and fill in your values.
# .env.local is never committed to GitHub.

# --- MySQL (your computer) ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Quickupp_USA
DB_USER=quickupp_app
DB_PASSWORD=QuickuppApp2026

# --- On Hostinger -------------------------------------------------------------
# Use the database name, user and password you create in hPanel
# (they start with a prefix like u123456789_), and keep DB_HOST=127.0.0.1

# --- CRM team accounts (/login -> /crm) ----------------------------------------
# npm run db:migrate adds these accounts once (passwords are stored hashed).
# Changing them here later does not change an existing account's password.
CRM_SUPERADMIN_NAME=Super Admin
CRM_SUPERADMIN_EMAIL=
CRM_SUPERADMIN_PASSWORD=
CRM_ADMIN_NAME=Admin
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=

# --- Email Notifications ------------------------------------------------------
# Use a mailbox on your domain (hPanel -> Emails). On Hostinger:
# SMTP_HOST=smtp.hostinger.com and SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where job applications are sent (defaults to hr@quickuppsoftech.us)
HR_EMAIL=hr@quickuppsoftech.us
# Where website contact & service leads are sent (defaults to info@quickuppsoftech.us)
LEADS_EMAIL=info@quickuppsoftech.us
# Where help & support inquiries are routed (defaults to support@quickuppsoftech.us)
SUPPORT_EMAIL=support@quickuppsoftech.us

# --- Website URL --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.quickuppsoftech.us

# --- PayPal Live / Sandbox Checkout -------------------------------------------
# Obtain from https://developer.paypal.com/dashboard/applications
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is used by the frontend to render the PayPal SDK buttons.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET is used securely on the server to create & capture orders.
PAYPAL_CLIENT_SECRET=
# 'live' for real payments, 'sandbox' for test mode
PAYPAL_MODE=live

# --- Calendly → CRM (Calendly Meetings) ----------------------------------------
# A Calendly personal access token: Calendly → Settings → Integrations & apps →
# API and webhooks → Personal access tokens → Generate new token.
# Works on every Calendly plan. The CRM reads Calendly when the Meetings page is
# opened and every minute while it stays open.
CALENDLY_TOKEN=
# Optional, needs a paid Calendly plan: a webhook to
#   https://www.quickuppsoftech.us/api/calendly/webhook
# (events invitee.created and invitee.canceled) pushes changes instantly.
# Put the webhook's signing key here.
CALENDLY_WEBHOOK_SIGNING_KEY=
